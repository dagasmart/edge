# ========== 网络 ==========
AUTH_PORT=9503
BACKLOG=4096

# ========== Redis ==========
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=uApDVQD7
REDIS_DB=2
REDIS_POOL_SIZE=512

# ========== 并发控制 ==========
MAX_CONCURRENCY=20000
#REUSEPORT 模式下 4 worker 各独立计数，设 2 等效全局 ~8 并发/设备
MAX_CONCURRENCY_PER_DEVICE=5

# ========== 缓存 ==========
CACHE_TTL=300
LOCAL_CACHE_TTL=60

# ========== 限流 ==========
RATE_MAX=20
RATE_TTL=60

# ========== HMAC / 安全 ==========
TIME_DRIFT=300

# ========== 路由基准前缀 ==========
AUTH_HTTP_PREFIX=/admin-api/extension/edge

# ========== 调试 ==========
DEBUG=false




# ---------------------以下配置放入项目根目录.env里------------------------------
# MQTT 核心配置（php-mqtt/laravel-client 专用）
# ---------------------------------------------------------------------------
# 默认连接名，必须和 config/mqtt-client.php 中 connections 的 key 一致
MQTT_DEFAULT_CONNECTION=nanomq
# MQTT 服务器地址
MQTT_HOST=1.15.51.149
# 基础端口（加密端口 8883，需开启 SSL）
MQTT_PORT=21883
# 认证模式：client_id设备 | username用户 | both双重
MQTT_AUTH_ONLINE_MODE=client_id
# 客户端ID，建议每个实例保持唯一
MQTT_CLIENT_ID=mqttx_718a1a25
# 认证账号（无认证则留空）
MQTT_AUTH_USERNAME=abc
# 认证密码（无认证则留空）
MQTT_AUTH_PASSWORD=123456
# 断开后是否清理会话（保留订阅则设为 false）
MQTT_CLEAN_SESSION=true
# 默认 QOS 级别（0/1/2，推荐 1 保证至少送达）
MQTT_QOS=1
# 连接超时时间（秒）
MQTT_CONNECT_TIMEOUT=3
# 心跳间隔（秒），避免服务器主动断开
MQTT_KEEP_ALIVE_INTERVAL=60
# ---------------------------------------------------------------------------
# MQTT 启动期探针（edge:insert-redis-dim 启动时执行）
# ---------------------------------------------------------------------------
MQTT_PROBE_TIMEOUT=3.0
MQTT_PROBE_RETRIES=2
# ---------------------------------------------------------------------------
# MQTT 运行期定时探针（启动成功后后台协程执行，失败只告警不退出）
# ---------------------------------------------------------------------------
MQTT_PROBE_INTERVAL_SEC=30
MQTT_PROBE_FAILURE_THRESHOLD=3
# ---------------------------------------------------------------------------
# SSL/TLS 加密连接配置（使用 8883 端口时启用）
# 注：常量名已与 edge.php 的 mqtt.tls.* 配置键对齐
# ---------------------------------------------------------------------------
MQTT_TLS_ENABLED=false
# 是否允许自签名证书（内网/测试环境可开启）
MQTT_TLS_ALLOW_SELF_SIGNED_CERT=false
# 是否验证服务端证书（生产环境建议 true）
MQTT_TLS_VERIFY_PEER=false
# 是否验证服务端证书中的主机名（生产环境建议 true）
MQTT_TLS_VERIFY_PEER_NAME=true
# CA 证书（验证服务端用，生产环境建议配置）
MQTT_TLS_CA_FILE=
MQTT_TLS_CA_PATH=
# 客户端证书（双向认证 mTLS 才需要）
MQTT_TLS_CLIENT_CERT_FILE=
MQTT_TLS_CLIENT_CERT_KEY_FILE=
MQTT_TLS_CLIENT_CERT_KEY_PASSPHRASE=
# ALPN 协议（一般不用）
MQTT_TLS_ALPN=
# EdgeAuth → Laravel 回源配置
EDGE_AUTH_FALLBACK_URL=http://ccs.dagasmart.com
EDGE_INTERNAL_TOKEN=1889832cde563c19d11562161d684234
# EdgeAuth → redis 回源配置
EDGE_REDIS_SHARDS=127.0.0.1:16379:uApDVQD7@2
EDGE_REDIS_POOL_SIZE=128
EDGE_REDIS_DB=2
# ---------------------------------------------------------------------------
# EdgeAuth
# ---------------------------------------------------------------------------
