# ========== 网络 ==========
AUTH_PORT=9503
BACKLOG=4096

# ========== Redis ==========
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=uApDVQD7
REDIS_DB=2
REDIS_POOL_SIZE=512

# ========== 并发控制 ==========
MAX_CONCURRENCY=20000
#REUSEPORT 模式下 4 worker 各独立计数，设 2 等效全局 ~8 并发/设备
MAX_CONCURRENCY_PER_DEVICE=5

# ========== 缓存 ==========
CACHE_TTL=300
LOCAL_CACHE_TTL=60

# ========== 限流 ==========
RATE_MAX=20
RATE_TTL=60

# ========== HMAC / 安全 ==========
TIME_DRIFT=300

# ========== 路由基准前缀 ==========
AUTH_HTTP_PREFIX=/admin-api/extension/edge/gateway

# ========== 调试 ==========
DEBUG=false
